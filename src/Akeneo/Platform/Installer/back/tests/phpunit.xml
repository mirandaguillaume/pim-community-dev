<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../../../../vendor/phpunit/phpunit/phpunit.xsd"
    backupGlobals="false"
    colors="true"
    processIsolation="false"
    stopOnFailure="false"
    bootstrap="../../../../../../config/bootstrap.php"
    cacheDirectory="/tmp/.phpunit.cache"
    failOnRisky="false"
    failOnWarning="false">

    <php>
        <ini name="date.timezone" value="Europe/Paris"/>
        <ini name="intl.default_locale" value="en"/>
        <ini name="intl.error_level" value="0"/>
        <ini name="memory_limit" value="-1"/>
        <ini name="zend.enable_gc" value="1"/>
        <server name="KERNEL_CLASS" value="Kernel" force="true" />
        <server name="FLAG_RESET_PIM_ENABLED" value="1" force="true" />
    </php>

    <!--
        Code-coverage source scope (PHPUnit 10) — same rationale as the root phpunit.xml.dist:
        without it the nightly coverage run exits 1 on a "No filter is configured" warning.
        Note that failOnWarning="false" above does not cover this case; the relevant toggle is
        failOnPhpunitWarning, which defaults to true.
    -->
    <source>
        <include>
            <directory>../src</directory>
        </include>
    </source>

    <testsuites>
        <testsuite name="Installer_Integration_Test">
            <directory>Integration</directory>
        </testsuite>
        <testsuite name="Installer_Acceptance_Test">
            <directory>Acceptance</directory>
        </testsuite>
    </testsuites>
</phpunit>
